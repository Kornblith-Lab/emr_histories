# Ignore virtual environments
venv/
.venv/
env/
.env

# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Ignore Python compiled files
*.egg-info/
dist/
build/

# Ignore Git
.git/
.gitignore
.gitattributes

# Ignore IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Ignore test and coverage files
.pytest_cache/
.coverage
htmlcov/
.tox/

# Ignore development files
.env.local
.env.*.local
